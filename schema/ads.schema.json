{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ads Document",
  "type": "object",
  "properties": {
    "city": { "type": "string" },
    "scope": { "type": "string", "enum": ["city","global"] },
    "enabled": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "approvalStatus": { "type": "string" },
    "ads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": ["string","number"] },
          "type": { "type": "string" },
          "creativeVersion": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "description": { "type": "string" },
          "shortText": { "type": "string" },
          "mediaUrl": { "type": "string", "format": "uri" },
          "mediaUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "thumbnailUrl": { "type": "string", "format": "uri" },
          "iconUrl": { "type": "string", "format": "uri" },
          "htmlContent": { "type": "string" },
          "actionUrl": { "type": "string", "format": "uri" },
          "actionLabel": { "type": "string" },
          "ctaTrackingId": { "type": "string" },
          "impressionTrackingUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "clickTrackingUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "clickUrlParams": { "type": "object" },
          "sponsorTag": { "type": "string" },
          "badgeText": { "type": "string" },
          "isDismissible": { "type": "boolean" },
          "dismissText": { "type": "string" },
          "locationInfo": { "type": "string" },
          "geoTargeting": { "type": "object" },
          "demographicTargeting": { "type": "object" },
          "targeting": { "type": "object" },
          "deviceConstraints": { "type": "object" },
          "schedule": { "type": "object" },
          "frequencyLimits": { "type": "object" },
          "showSettings": { "type": "object" },
          "creative": { "type": "object" },
          "reward": { "type": "object" },
          "collectionItems": { "type": "array" },
          "items": { "type": "array" },
          "analyticsTags": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "categories": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object" },
          "customData": { "type": "object" },
          "localization": { "type": "object" },
          "rating": { "type": "number" }
        },
        "additionalProperties": true
      }
    }
  },
  "required": ["scope","enabled","ads"],
  "additionalProperties": true
}
